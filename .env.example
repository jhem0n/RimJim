# DATABASE_URL: PostgreSQL or Supabase connection string for persistent data storage
DATABASE_URL="postgresql://user:password@localhost:5432/rimjim"

# TMDB_API_KEY: The Movie Database (TMDB) API Key (v3 auth or Read Access Token)
TMDB_API_KEY=""

# AUTH_SECRET: Secret key for signing sessions and tokens
AUTH_SECRET="rimjim_super_secret_session_key_change_in_production"

# GEMINI_API_KEY: Optional AI assistant key if needed
GEMINI_API_KEY=""

# APP_URL: The public or local URL where RimJim is hosted
APP_URL="http://localhost:3000"
